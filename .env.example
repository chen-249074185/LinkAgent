# ===== LinkAgent docker-compose 密钥模板（复制为 .env 并填值，.env 已 gitignore 零明文入库）=====
DASHSCOPE_API_KEY=
ADMIN_TOKEN_WEB=
DEEPSEEK_API_KEY=
SENIVERSE_API_KEY=
AMAP_KEY=
# Web 端地图（高德 JS API）需要，缺省时地图不可用，不影响后端
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
MYSQL_PASSWORD=
MAIL_USER=
MAIL_AUTH_CODE=
JWT_SECRET=
# 敏感字段落库加密密钥（AES-256-GCM）；留空则回退用 JWT_SECRET 派生，生产建议单独配置
FIELD_ENCRYPTION_KEY=
LUCKIN_MCP_TOKEN=
LIEPIN_USER_TOKEN=